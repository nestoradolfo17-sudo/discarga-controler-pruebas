# Copia este archivo a ".env.local" y pon aquí los valores reales de tu
# proyecto de Supabase (Project Settings → API, dentro de supabase.com).
#
# Si dejas ".env.local" sin crear (o sin estos valores), la aplicación sigue
# funcionando en modo local normal (localStorage, sin base de datos
# compartida) — no es obligatorio configurarlo para seguir usando la app como
# antes.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Solo para modo local (sin Supabase): contraseña del usuario "admin" de ejemplo.
# Si no se define, el acceso local queda deshabilitado. NO usar en Netlify.
# VITE_LOCAL_ADMIN_PASSWORD=
